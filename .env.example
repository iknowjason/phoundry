# ── Azure Foundry ────────────────────────────────────────────────────────────
# Foundry resource NAME (not the full URL). The Anthropic endpoint is derived as
# https://<resource>.services.ai.azure.com/anthropic/v1/messages
ANTHROPIC_FOUNDRY_RESOURCE=

# Foundry *project* endpoint — used for tracing and for GPT-family models.
FOUNDRY_PROJECT_ENDPOINT=

# Model deployment names as created in Foundry.
TRIAGE_MODEL=claude-sonnet-5
ESCALATION_MODEL=claude-opus-5

# Auth: leave ANTHROPIC_FOUNDRY_API_KEY blank to use Entra ID via `az login`
# (recommended — the analyst's own identity is what shows up in the audit log).
ANTHROPIC_FOUNDRY_API_KEY=

# ── Sublime Security ─────────────────────────────────────────────────────────
# Regional base URL. One of:
#   https://platform.sublime.security          (NA-East, default)
#   https://na-west.platform.sublime.security
#   https://ca.platform.sublime.security
#   https://uk.platform.sublime.security
#   https://eu.platform.sublime.security
#   https://au.platform.sublime.security
SUBLIME_BASE_URL=https://platform.sublime.security
SUBLIME_API_KEY=

# ── VirusTotal ───────────────────────────────────────────────────────────────
VT_API_KEY=
# public = 4 req/min, 500/day. premium = no client-side throttle.
VT_TIER=public

# ── Safety switches ──────────────────────────────────────────────────────────
# Never let the agent call Sublime's action API unless this is explicitly true.
ALLOW_MAILBOX_ACTIONS=false
# Never submit content to VirusTotal (uploads are public to VT enterprise subs).
ALLOW_VT_SUBMIT=false
